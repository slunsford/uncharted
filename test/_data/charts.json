{
  "releases": {
    "type": "stacked-column",
    "title": "Release Cadence",
    "subtitle": "By quarter",
    "file": "charts/releases.csv",
    "x": {
      "column": "label"
    },
    "y": {
      "columns": {
        "production": "Production",
        "hotfix": "Hotfix",
        "beta": "Beta"
      }
    },
    "legend": true
  },
  "adoption": {
    "type": "dot",
    "title": "AI-Assisted Development",
    "subtitle": "PRs and commits by month",
    "file": "charts/adoption.csv",
    "x": {
      "column": "label"
    },
    "y": {
      "columns": {
        "prs": "Pull Requests",
        "commits": "Commits"
      },
      "max": 60
    },
    "legend": true
  },
  "scatter": {
    "type": "scatter",
    "title": "Performance Metrics",
    "subtitle": "Alpha vs Beta",
    "file": "charts/scatter-data.csv",
    "x": {
      "column": "x",
      "max": 100,
      "title": "X Performance"
    },
    "y": {
      "column": "y",
      "max": 100,
      "title": "Y Performance"
    },
    "label": {
      "column": "label"
    },
    "series": {
      "column": "series",
      "title": "Group"
    },
    "legend": true
  },
  "temperature": {
    "type": "dot",
    "title": "Temperature Range",
    "subtitle": "Monthly highs and lows (°C)",
    "file": "charts/temperature.csv",
    "y": {
      "columns": {
        "High": "High",
        "Low": "Low"
      }
    },
    "legend": true
  },
  "quadrant": {
    "type": "scatter",
    "title": "Quadrant Analysis",
    "subtitle": "Data across all four quadrants",
    "file": "charts/quadrant.csv",
    "series": {
      "column": "series",
      "title": "Group"
    },
    "legend": true
  },
  "profit": {
    "type": "stacked-column",
    "title": "Quarterly Revenue",
    "subtitle": "Cost + Profit/Loss",
    "file": "charts/profit.csv",
    "y": {
      "columns": {
        "Cost": "Cost",
        "Profit": "Profit/Loss"
      }
    },
    "animate": true,
    "legend": true
  },
  "line": {
    "type": "line",
    "title": "AI-Assisted Development",
    "subtitle": "PRs and commits by month (line)",
    "file": "charts/adoption.csv",
    "y": {
      "columns": {
        "prs": "Pull Requests",
        "commits": "Commits"
      },
      "max": 60
    },
    "legend": true,
    "animate": true,
    "dots": true
  },
  "sankey-basic": {
    "type": "sankey",
    "title": "Budget Allocation",
    "subtitle": "Simple 2-level flow",
    "file": "charts/sankey-basic.csv",
    "source": {
      "column": "source"
    },
    "target": {
      "column": "target"
    },
    "value": {
      "column": "value",
      "format": {
        "compact": true,
        "currency": {
          "symbol": "$"
        }
      }
    },
    "legend": true,
    "proportional": true
  },
  "sankey-multi": {
    "type": "sankey",
    "title": "Budget to Revenue",
    "subtitle": "Multi-level flow diagram",
    "file": "charts/sankey-multi.csv",
    "value": {
      "format": {
        "compact": true,
        "currency": {
          "symbol": "$"
        }
      }
    },
    "animate": true,
    "proportional": true
  },
  "legacy-deprecation-test": {
    "type": "dot",
    "title": "Legacy Schema Test",
    "subtitle": "Tests deprecation warnings",
    "file": "charts/adoption.csv",
    "max": 60,
    "columns": {
      "y": ["prs", "commits"]
    },
    "legend": ["Pull Requests", "Commits"]
  },
  "legacy-scatter-test": {
    "type": "scatter",
    "title": "Legacy Scatter Test",
    "subtitle": "Tests deprecated scatter options",
    "file": "charts/scatter-data.csv",
    "maxX": 100,
    "maxY": 100,
    "titleX": "X Value",
    "titleY": "Y Value",
    "legendTitle": "Series",
    "legend": ["Alpha Group", "Beta Group"]
  }
}
